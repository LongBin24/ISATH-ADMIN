# ==================================================
# BACKEND API
# ==================================================
NEXT_PUBLIC_API_URL=https://ite-api.istashkh.com/api/v1
BACKEND_URL=https://ite-api.istashkh.com

# ==================================================
# KEYCLOAK CORE
# ==================================================
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://ite-keycloak.istashkh.com/realms/istash
KEYCLOAK_CLIENT_ISSUER=https://ite-keycloak.istashkh.com/realms/istash

# ==================================================
# KEYCLOAK LOGIN CLIENT - ADMIN PORTAL
# ==================================================
KEYCLOAK_CLIENT_ID=istash-client
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret

# KEYCLOAK ADMIN SERVICE
KEYCLOAK_ADMIN_CLIENT_ID=istash-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-keycloak-admin-client-secret

KEYCLOAK_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/verified

# ==================================================
# BETTER AUTH - ADMIN PORTAL
# ==================================================
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ==================================================
# Facebook OAuth for Better Auth
# ==================================================
FACEBOOK_CLIENT_ID=replace-with-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-client-secret

# ==================================================
# Optional Keycloak identity-provider aliases
# ==================================================
KEYCLOAK_GOOGLE_IDP_ALIAS=google
KEYCLOAK_FACEBOOK_IDP_ALIAS=facebook